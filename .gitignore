# Hugo build output.
#
# .github/workflows/main.yml runs `npm run build` (hugo --gc --minify) and
# uploads ./public to Pages, so the built site is regenerated from source on
# every deploy. Committing it as well only creates drift: an edit to content or
# a layout that isn't followed by a local rebuild leaves the repo describing a
# site that doesn't match itself.
public/
other_data/

# Hugo's asset cache (compiled SCSS, resized images). Regenerated on build.
resources/_gen/

# Build-time scratch files.
.hugo_build.lock
hugo_stats.json

# Dependencies
node_modules/

# Environment
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
Thumbs.db
*.swp
.idea/

# Local Hugo verification build output.
.hugo-results-check/

# Source masters for the Events Coverage page. The site serves the compressed
# copies in static/videos/web/ and static/images/events_coverage/; the master
# film is over GitHub's 100 MB file limit.
static/videos/media_broadcast.mp4
static/images/media_broadcast_*.png
